{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meta-groups.schema.json",
  "title": "meta/groups.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "groups"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "group_id",
          "name",
          "members"
        ],
        "properties": {
          "group_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "entity_id",
                "valid_from",
                "valid_to"
              ],
              "properties": {
                "entity_id": {
                  "type": "string"
                },
                "valid_from": {
                  "type": "string"
                },
                "valid_to": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
