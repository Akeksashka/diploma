{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "export-status.schema.json",
  "title": "export-status.json (artifact only; recorded by record-export into ops.export_status)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "ingest_run_id", "analysis_run_id", "duration_ms", "bytes_read",
    "sessions", "file_counts", "detail"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["ok", "partial", "failed"]},
    "ingest_run_id": {"type": "integer", "minimum": 1},
    "analysis_run_id": {"type": ["integer", "null"]},
    "duration_ms": {"type": "integer", "minimum": 0},
    "bytes_read": {"type": "integer", "minimum": 0},
    "sessions": {"type": "integer", "minimum": 0},
    "file_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["json", "parquet", "total"],
      "properties": {
        "json": {"type": "integer", "minimum": 0},
        "parquet": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0}
      }
    },
    "detail": {
      "type": "object",
      "required": ["bytes_written", "failures", "warnings"],
      "properties": {
        "bytes_written": {"type": "integer", "minimum": 0},
        "failures": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
