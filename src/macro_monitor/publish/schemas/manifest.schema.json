{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "Dashboard export manifest (docs/specs/dashboard-export-spec.md section 3)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "build_id", "generated_at", "ingest_run_id", "analysis_run_id",
    "known_cutoff", "code_version", "history_start", "files", "totals"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"},
    "build_id": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}Z-r[0-9]+$"},
    "generated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z$"},
    "ingest_run_id": {"type": "integer", "minimum": 1},
    "analysis_run_id": {"type": "integer", "minimum": 1},
    "known_cutoff": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}(\\.[0-9]+)?Z$"},
    "code_version": {"type": "string", "minLength": 1},
    "history_start": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "format", "bytes", "rows", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "format": {"enum": ["json", "parquet"]},
          "bytes": {"type": "integer", "minimum": 0},
          "rows": {"type": ["integer", "null"], "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "files"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 0},
        "files": {"type": "integer", "minimum": 0}
      }
    }
  }
}
