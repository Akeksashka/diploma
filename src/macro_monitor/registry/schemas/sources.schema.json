{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "macro-monitor/sources.schema.json",
  "title": "config/sources.yaml (docs/specs/source-config-schema.md sections 1 and 2)",
  "type": "object",
  "properties": {
    "archive_policy": {
      "type": "object",
      "properties": {
        "private_repo": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        }
      },
      "additionalProperties": false,
      "required": [
        "private_repo"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "archive_policy",
    "sources"
  ],
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "sdmx",
            "rest",
            "bulk",
            "web",
            "manual"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "wave": {
          "type": "integer",
          "minimum": 1
        },
        "base_url": {
          "type": "string",
          "minLength": 1
        },
        "auth": {
          "$ref": "#/$defs/auth"
        },
        "http": {
          "type": "object",
          "properties": {
            "user_agent_template": {
              "type": "string",
              "minLength": 1
            },
            "timeout_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "retries": {
              "type": "object",
              "properties": {
                "max": {
                  "type": "integer",
                  "minimum": 0
                },
                "backoff_s": {
                  "type": "number",
                  "minimum": 0
                },
                "backoff_factor": {
                  "type": "number",
                  "minimum": 1
                },
                "jitter": {
                  "type": "boolean"
                },
                "on": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 100,
                        "maximum": 599
                      },
                      {
                        "const": "timeout"
                      }
                    ]
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "rate_limit": {
          "type": "object",
          "properties": {
            "max_concurrent": {
              "type": "integer",
              "minimum": 1
            },
            "min_interval_s": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "budget_per_hour": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "budget_per_day": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "max_requests_per_run": {
              "type": "integer",
              "minimum": 1
            },
            "source_note": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "licence": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "minLength": 1
            },
            "checked_on": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "format": "date"
            },
            "non_commercial_ok": {
              "type": "boolean"
            },
            "attribution": {
              "type": "string"
            },
            "redistribution_of_raw": {
              "enum": [
                "allowed",
                "unclear",
                "forbidden"
              ]
            },
            "user_decision": {
              "type": "object",
              "properties": {
                "by": {
                  "type": "string",
                  "minLength": 1
                },
                "on": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                  "format": "date"
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false,
              "required": [
                "by",
                "on",
                "rationale"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "id",
            "url",
            "checked_on",
            "non_commercial_ok",
            "attribution",
            "redistribution_of_raw"
          ]
        },
        "archive": {
          "enum": [
            "public",
            "hash_only",
            "private"
          ]
        },
        "publish_site": {
          "enum": [
            "public",
            "withheld"
          ]
        },
        "automated_access": {
          "enum": [
            "allowed",
            "manual_only",
            "unknown"
          ]
        },
        "terms_review": {
          "type": "object",
          "properties": {
            "decision": {
              "enum": [
                "permitted",
                "forbidden",
                "unclear"
              ]
            },
            "reviewed_on": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "format": "date"
            },
            "url": {
              "type": "string",
              "minLength": 1
            },
            "clause": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "decision",
            "reviewed_on",
            "url",
            "clause"
          ]
        },
        "robots_review": {
          "type": "object",
          "properties": {
            "robots_url": {
              "type": "string",
              "minLength": 1
            },
            "decision": {
              "enum": [
                "permitted",
                "disallowed",
                "not_applicable_documented_api"
              ]
            },
            "reviewed_on": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "format": "date"
            }
          },
          "additionalProperties": false,
          "required": [
            "robots_url",
            "decision",
            "reviewed_on"
          ]
        },
        "change_detection": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "http_validators",
              "update_marker",
              "content_hash"
            ]
          }
        },
        "inbox": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sidecar_required": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "sidecar_optional": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "path"
          ]
        },
        "reminders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "expected_window": {
                "type": "object",
                "properties": {
                  "month": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 12
                  },
                  "from_day": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 31
                  },
                  "to_day": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 31
                  }
                },
                "additionalProperties": false,
                "required": [
                  "month",
                  "from_day",
                  "to_day"
                ]
              },
              "remind_on": {
                "type": "object",
                "properties": {
                  "month": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 12
                  },
                  "day": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 31
                  }
                },
                "additionalProperties": false,
                "required": [
                  "month",
                  "day"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "expected_window",
              "remind_on",
              "text"
            ]
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "provider",
        "kind",
        "enabled",
        "licence",
        "archive",
        "publish_site",
        "groups"
      ]
    },
    "auth": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "none"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "api_key"
            },
            "env": {
              "type": "string",
              "minLength": 1
            },
            "in": {
              "enum": [
                "header",
                "query"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "env",
            "in",
            "name"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "token"
            },
            "env": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "env"
          ]
        }
      ]
    },
    "group": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "enabled": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "request_template": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "params": {
              "type": "object"
            },
            "datasets": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "fixed_filters": {
              "type": "object"
            },
            "discover": {
              "type": "object",
              "properties": {
                "landing_url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "link_pattern": {
                  "type": "string",
                  "minLength": 1
                },
                "expect_matches": {
                  "type": "integer",
                  "minimum": 1
                },
                "allowed_hosts": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "landing_url",
                "link_pattern",
                "allowed_hosts"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "parser": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"
        },
        "missing_markers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fetch_scope": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "mode_default": {
          "enum": [
            "full",
            "incremental"
          ]
        },
        "full_refresh_every": {
          "type": "integer",
          "minimum": 1
        },
        "series_map": {
          "type": "string",
          "minLength": 1
        },
        "expected_series_min": {
          "type": "integer",
          "minimum": 0
        },
        "freshness": {
          "type": "object",
          "properties": {
            "frequency": {
              "type": "string",
              "minLength": 1
            },
            "typical_lag_days": {
              "type": "integer",
              "minimum": 0
            },
            "tolerance_days": {
              "type": "integer",
              "minimum": 0
            },
            "release_months": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              }
            }
          },
          "additionalProperties": false
        },
        "job_timeout_min": {
          "type": "integer",
          "minimum": 10,
          "maximum": 355
        },
        "reestimating": {
          "type": "boolean"
        },
        "edition_ordered": {
          "type": "boolean"
        },
        "published_precision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 12
        },
        "revision": {
          "type": "object",
          "properties": {
            "compare": {
              "enum": [
                "published_decimals",
                "fixed_decimals"
              ]
            },
            "decimals": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "rel_epsilon": {
              "type": "number",
              "minimum": 0
            },
            "max_revised_rows": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "materiality_abs": {
              "type": "number",
              "minimum": 0
            },
            "materiality_rel": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "snapshot_mode": {
              "enum": [
                "none",
                "diff_above_tol"
              ]
            }
          },
          "additionalProperties": false
        },
        "max_insert_rows_per_load": {
          "type": "integer",
          "minimum": 1
        },
        "on_failure": {
          "enum": [
            "alert",
            "alert_and_block_dependents"
          ]
        },
        "unit_from_expect": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "format",
        "parser",
        "fetch_scope",
        "series_map",
        "expected_series_min",
        "freshness"
      ]
    }
  }
}
