{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "public-dump-manifest.schema.json",
  "title": "Public dump manifest (ADR-015, docs/specs/public-dump-spec.md section 3)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version", "dump_id", "created_at", "ingest_run_id", "git_sha", "code_version",
    "snapshot", "partition", "schema", "files", "load_order", "sequences", "trigger_tables",
    "sources", "totals"
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "table": {"type": "string", "pattern": "^[a-z_]+\\.[a-z_0-9]+$"},
    "count": {"type": "integer", "minimum": 0}
  },
  "properties": {
    "format_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "dump_id": {"type": "string", "pattern": "^db-dump-public-[0-9]{4}-[0-9]{2}(-r[0-9]+)?$"},
    "created_at": {"type": "string", "minLength": 20},
    "ingest_run_id": {"type": "integer", "minimum": 1},
    "git_sha": {"type": "string", "minLength": 1},
    "code_version": {"type": "string", "minLength": 1},
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isolation", "database_clock", "max_loaded_at"],
      "properties": {
        "isolation": {"const": "repeatable read"},
        "database_clock": {"type": "string", "minLength": 20},
        "max_loaded_at": {"type": ["string", "null"]}
      }
    },
    "partition": {"const": "P-public"},
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "schema_version", "migrations"],
      "properties": {
        "path": {"const": "schema.sql"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"$ref": "#/$defs/count"},
        "schema_version": {"$ref": "#/$defs/count"},
        "migrations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "name", "sha256"],
            "properties": {
              "version": {"$ref": "#/$defs/count"},
              "name": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "view", "target_table", "path", "part", "columns", "order_key", "rows", "bytes_gz",
          "sha256_gz", "bytes_csv", "sha256_csv"
        ],
        "properties": {
          "view": {"type": "string", "pattern": "^pubdump\\.v_[a-z_0-9]+$"},
          "target_table": {"$ref": "#/$defs/table"},
          "path": {"type": "string", "pattern": "^data/[a-z_]+\\.[a-z_0-9]+(\\.part-[0-9]{4})?\\.csv\\.gz$"},
          "part": {"type": ["integer", "null"], "minimum": 1},
          "columns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "order_key": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "rows": {"$ref": "#/$defs/count"},
          "bytes_gz": {"$ref": "#/$defs/count"},
          "sha256_gz": {"$ref": "#/$defs/sha256"},
          "bytes_csv": {"$ref": "#/$defs/count"},
          "sha256_csv": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "load_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/table"}},
    "sequences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "table", "column"],
        "properties": {
          "sequence": {"type": "string"},
          "table": {"$ref": "#/$defs/table"},
          "column": {"type": "string"}
        }
      }
    },
    "trigger_tables": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/table"}},
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded"],
      "properties": {
        "included": {"type": "array", "items": {"type": "string"}},
        "excluded": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "reason"],
            "properties": {
              "source_id": {"type": "string"},
              "reason": {"enum": ["archive_mode", "publish_site"]}
            }
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "rows", "bytes_gz"],
      "properties": {
        "files": {"$ref": "#/$defs/count"},
        "rows": {"$ref": "#/$defs/count"},
        "bytes_gz": {"$ref": "#/$defs/count"}
      }
    }
  }
}
